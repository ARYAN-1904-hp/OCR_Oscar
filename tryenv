PROJECT_NAME=Intake_Agent_OCR_Engine

# Storage
STORAGE_DIR=handler_checker/storage
ORIGINALS_DIR=handler_checker/storage/originals
OUTPUTS_DIR=handler_checker/storage/outputs

# Metadata
METADATA_DIR=handler_checker/metadata
METADATA_FILE=handler_checker/metadata/metadata.json

# Queue
QUEUE_DIR=handler_checker/queue
